# blackout.network scanner worker (Render background worker, 1c-2g + 1 GB disk).
# Does not serve HTTP. Start command runs app/scanner_worker.py.
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 TZ=America/New_York
ENV MALLOC_ARENA_MAX=2
ENV X_READS_OFF=1 NEWSLETTER_NO_WORKER=1 BN_NO_STREAMWATCH=1 BN_NO_SNAPSHOTS=1
ENV BN_WORKER_DATA=/data BN_WORKER_INTERVAL_MINUTES=9
RUN useradd --create-home --uid 10001 bn
WORKDIR /workspace/blackout
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY app/ /workspace/blackout/
RUN mkdir -p /data logs && chown -R bn:bn /workspace /data
# Worker-only tests (offline). Location guard stays on the web image.
RUN cd /workspace/blackout && python3 -m unittest tests.test_scanner_worker
# Start as root so the entrypoint can chown the mounted disk, then drop to bn.
USER root
CMD ["python3", "scanner_worker.py"]
