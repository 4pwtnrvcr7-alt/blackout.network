{
  "name": "BLACKOUT.NETWORK",
  "short_name": "BLACKOUT",
  "description": "Signal over noise. Global threats ranked 0–10, sourced and updated hourly.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0B0D10",
  "background_color": "#0B0D10",
  "lang": "en",
  "icons": [
    {
      "src": "/icons/icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://blackout.network/manifest.webmanifest"
    }
  ]
}
